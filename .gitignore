# notes and processed outputs, never the raw dumps.
data/raw/
data/processed/
*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Model artifacts / embeddings caches
*.pt
embeddings/
